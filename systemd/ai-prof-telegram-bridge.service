[Unit]
Description=AI PROF Telegram control bridge V3
After=network-online.target ai-prof-control-center.service
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/projects/ai-prof-control-center
ExecStart=/usr/bin/python3 /home/agent/projects/ai-prof-control-center/orchestrator/telegram_bridge_v3.py
Environment=HOME=/home/agent
Environment=AI_PROF_STATE_DIR=/home/agent/.local/state/ai-prof-control-center
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/agent/.config/ai-prof-control-center
ReadWritePaths=/home/agent/.local/state/ai-prof-control-center
UMask=0077

[Install]
WantedBy=default.target
