[Unit]
Description=AI PROF Control Center autonomous intake loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/agent/projects/ai-prof-control-center
ExecStart=/usr/bin/python3 /home/agent/projects/ai-prof-control-center/orchestrator/control_loop.py --daemon
Environment=AI_PROF_STATE_DIR=/home/agent/.local/state/ai-prof-control-center
Restart=on-failure
RestartSec=15
NoNewPrivileges=false
# Bubblewrap must create its own user, mount, PID, IPC, UTS and cgroup
# namespaces. Keep these explicitly available even when the user manager
# has namespace hardening defaults; Bubblewrap remains the confinement
# boundary and still drops the host filesystem with --tmpfs /.
PrivateUsers=false
RestrictNamespaces=no
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/agent/.local/state/ai-prof-control-center /home/agent/projects/ai-prof-pilot-sandbox /home/agent/projects/ak-bermet /home/agent/projects/ai-prof-control-center-maintenance
UMask=0077

[Install]
WantedBy=default.target
