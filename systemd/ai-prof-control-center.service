[Unit]
Description=AI PROF Control Center autonomous intake loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/agent/projects/ai-prof-control-center
ExecStart=/usr/bin/python3 /home/agent/projects/ai-prof-control-center/orchestrator/control_loop.py --daemon
Environment=AI_PROF_STATE_DIR=/home/agent/.local/state/ai-prof-control-center
Restart=on-failure
RestartSec=15
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/agent/.local/state/ai-prof-control-center /home/agent/projects/ai-prof-pilot-sandbox /home/agent/projects/ak-bermet
UMask=0077

[Install]
WantedBy=default.target
