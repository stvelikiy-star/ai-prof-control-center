[Unit]
Description=AI PROF Repair Team shadow diagnosis and repair-task bridge
After=network-online.target ai-prof-repair-monitor.service
Wants=network-online.target

[Service]
Type=oneshot
User=agent
Group=agent
WorkingDirectory=/home/agent/projects/ai-prof-control-center
ExecStart=/usr/bin/python3 /home/agent/projects/ai-prof-control-center/orchestrator/diagnosis_queue_drain.py
ExecStart=/usr/bin/python3 /home/agent/projects/ai-prof-control-center/orchestrator/repair_task_bridge_drain.py
ExecStart=/usr/bin/python3 /home/agent/projects/ai-prof-control-center/orchestrator/shadow_queue_health.py
Environment=HOME=/home/agent
Environment=AI_PROF_STATE_DIR=/home/agent/.local/state/ai-prof-control-center
SuccessExitStatus=0 1
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/home/agent/.local/state/ai-prof-control-center
UMask=0077

# Deliberately no project checkout in ReadWritePaths. Diagnosis is read-only and
# the bridge may only create a validated task inside AI PROF state/queue.

[Install]
WantedBy=default.target
